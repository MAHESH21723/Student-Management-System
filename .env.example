# Copy to .env and adjust. The real .env is gitignored.

# Flask session/CSRF signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty, a random key is generated on every start (sessions reset on restart).
SECRET_KEY=

# Optional: path to the SQLite file (defaults to ./students.db)
DATABASE_PATH=

# Optional: local port (defaults to 5000)
PORT=5000

# Optional: set to 1 for the Flask debugger/reloader (development only)
FLASK_DEBUG=0
